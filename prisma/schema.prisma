generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:/opt/fx-web/data/site.db"
}

model ContactLead {
  id             String                     @id @default(cuid())
  name           String
  company        String?
  contact        String
  email          String
  message        String
  createdAt      DateTime                   @default(now())
  mailDeliveries ContactLeadEmailDelivery[]
}

model ContactLeadEmailDelivery {
  id                String      @id @default(cuid())
  leadId            String
  recipients        String
  sender            String?
  subject           String
  status            String
  error             String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  lead              ContactLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model SiteContent {
  key       String   @id
  value     String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  passwordSalt   String
  sessionVersion Int      @default(1)
  disabled       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
