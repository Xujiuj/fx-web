     private static final String AUTO_PREFIX = "INSTALL-AUTO-";
     private static final int DIGEST_LENGTH = 24;
+    private static final Pattern CONFIGURED_INSTALL_ID_PATTERN =
+        Pattern.compile("[A-Z0-9][A-Z0-9._:-]{7,127}");
 
